// ╔══════════════════════════════════════════════════════════════════════════╗
// ║         COMPANY MANAGEMENT MODULE (Integrated from Company-Manager)    ║
// ╚══════════════════════════════════════════════════════════════════════════╝

// ── Core: Company ──────────────────────────────────────────────────────────

model Company {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  website   String?       @unique
  logo      String?
  email     String?
  phone     String?
  status    CompanyStatus @default(PENDING)
  settings  Json?         @default("{}")
  adminId   String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  admin            Employee?         @relation("CompanyAdmin", fields: [adminId], references: [id])
  employees        Employee[]        @relation("CompanyEmployees")
  users            User[]            @relation("UserCompany")
  primaryUsers     User[]            @relation("UserPrimaryCompany")
  managers         User[]            @relation("CompanyManager")
  userCompanies    UserCompany[]
  userCompanyRoles UserCompanyRole[]

  announcements     Announcement[]
  leavePolicies     LeavePolicy[]
  companyHolidays   CompanyHoliday[]
  hrDepartments     HrDepartment[]
  hrDesignations    HrDesignation[]
  hrBranches        HrBranch[]
  workShifts        WorkShift[]
  onboardingTemplates OnboardingTemplate[]
  jobOpenings       JobOpening[]
  candidates        Candidate[]
  assets            Asset[]
  budgets           Budget[]
  clients           Client[]
  expenses          Expense[]
  locations         Location[]
  projects          Project[]
  clientRetainers   ClientRetainer[]
  hrLetterTemplates HrLetterTemplate[]
  hrLetters         HrLetter[]
  performanceCycles PerformanceCycle[]
  travelRequests    TravelRequest[]
  hrTickets         HrTicket[]
  hrPolicyDocs      HrPolicyDoc[]
  suppliers         Supplier[]
  products          Product[]
  purchaseOrders    PurchaseOrder[]
  salesOrders       SalesOrder[]
  stockTransfers    StockTransfer[]
  leads             Lead[]                  @relation("CompanyLeads")
  companyTasks      CompanyTask[]
  inventoryRecords  InventoryRecord[]
  supportCustomers  Customer[]
  supportGroups     SupportGroup[]
  knowledgeArticles KnowledgeArticle[]
  cannedResponses   SupportCannedResponse[]
  slaPolicies       SlaPolicy[]
  liveChatSessions  LiveChatSession[]
  serviceContracts  ServiceContract[]
  companyAgent      CompanyAgent?
  visitTags         VisitTag[]
  customerVisits    CustomerVisit[]
  demoEquipmentUnits DemoEquipmentUnit[]
  demoEquipmentMovements DemoEquipmentMovement[]
  savedTicketFilters SavedTicketFilter[]
  ticketCustomFields TicketCustomFieldDef[]
  roadmapItems      RoadmapItem[]

  @@index([slug])
  @@index([status])
}

/// One ops agent identity per tenant company
model CompanyAgent {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  name                 String   @default("OPS")
  /// Preferred Gemini model id (without models/ prefix)
  preferredModel       String?
  /// Ordered fallback model ids
  fallbackModels       Json     @default("[]")
  systemPromptExtra    String?
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  threads              AgentThread[]

  @@index([companyId])
}

model AgentThread {
  id        String          @id @default(cuid())
  companyId String
  agentId   String
  userId    String
  title     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  agent     CompanyAgent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  toolRuns  AgentToolRun[]

  @@index([companyId])
  @@index([agentId])
  @@index([userId])
  @@index([updatedAt])
}

model AgentMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String
  /// Text content and/or structured parts (tool calls, etc.)
  content   Json
  createdAt DateTime @default(now())
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([createdAt])
}

model AgentToolRun {
  id          String   @id @default(cuid())
  threadId    String
  toolName    String
  args        Json
  result      Json?
  status      String   @default("pending")
  /// pending | confirmed | executed | rejected | error
  error       String?
  createdAt   DateTime @default(now())
  executedAt  DateTime?
  thread      AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([status])
}

// ── HR: Employee & Related ────────────────────────────────────────────────

model Employee {
  id             String         @id @default(cuid())
  userId         String?        @unique
  employeeId     String         @unique // Human-readable ID e.g. "EMP-001"
  name           String
  email          String         @unique
  phone          String
  address        Json
  jobTitle       String
  department     String
  dateJoined     DateTime       @default(now())
  role           EmployeeRole   @default(EMPLOYEE)
  employmentType EmploymentType @default(FULL_TIME)
  status         EmployeeStatus @default(PENDING)
  companyId      String
  managerId      String?
  departmentId   String?
  designationId  String?
  branchId       String?
  isApproved     Boolean        @default(false)
  avatar         String?
  dateOfBirth    DateTime?
  gender         String?
  emergencyContact Json?
  customFields   Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  user             User?                @relation("UserEmployee", fields: [userId], references: [id])
  company          Company              @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Cascade)
  adminOf          Company?             @relation("CompanyAdmin")
  manager          Employee?            @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  subordinates     Employee[]           @relation("EmployeeHierarchy")
  hrDepartment     HrDepartment?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      HrDesignation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  branch           HrBranch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  leaveActions     LeaveRequest[]       @relation("LeaveRequestActions")
  leaveBalances    LeaveBalance[]
  payslips         Payslip[]
  salary           EmployeeSalary[]
  sentMessages     EmployeeMessage[]    @relation("SentMessages")
  receivedMessages EmployeeMessage[]    @relation("ReceivedMessages")
  assignedTasks    CompanyTask[]        @relation("TaskAssignee")
  createdTasks     CompanyTask[]        @relation("TaskCreator")
  taskComments     CompanyTaskComment[]
  assignedLeads    Lead[]               @relation("EmployeeAssignedLeads")
  leadActivities   LeadActivity[]       @relation("EmployeeLeadActivities")
  leadDocuments    LeadDocument[]
  companyRoles     UserCompanyRole[]
  documents        EmployeeDocument[]
  skills           EmployeeSkill[]
  dependents       EmployeeDependent[]
  activities       EmployeeActivity[]   @relation("EmployeeActivities")
  actedActivities  EmployeeActivity[]   @relation("EmployeeActivityActor")
  uploadedDocuments EmployeeDocument[]  @relation("DocumentUploader")
  shiftAssignments  EmployeeShiftAssignment[]
  attendanceCorrections AttendanceCorrection[]
  onboardingChecklist OnboardingChecklist?
  exitRequests      ExitRequest[]
  statutoryProfile  StatutoryProfile?
  interviewsAsInterviewer Interview[] @relation("InterviewInterviewer")
  assignedAssets        Asset[]               @relation("EmployeeAssets")
  hrLetters             HrLetter[]
  timesheets            Timesheet[]
  timesheetApprovals    Timesheet[]           @relation("TimesheetApprover")
  performanceGoals      PerformanceGoal[]
  performanceReviews    PerformanceReview[]   @relation("ReviewSubject")
  reviewsAsManager      PerformanceReview[]   @relation("ReviewManager")
  expenseClaims         Expense[]             @relation("EmployeeExpenses")
  expenseApprovals      Expense[]             @relation("ExpenseApprover")
  travelRequests        TravelRequest[]
  travelApprovals       TravelRequest[]       @relation("TravelApprover")
  hrTickets             HrTicket[]            @relation("HrTicketRequester")
  hrTicketsAssigned     HrTicket[]            @relation("HrTicketAssignee")

  @@index([companyId])
  @@index([email])
  @@index([managerId])
  @@index([userId])
  @@index([status])
  @@index([departmentId])
  @@index([designationId])
  @@index([branchId])
}

model HrDepartment {
  id        String         @id @default(cuid())
  companyId String
  name      String
  code      String?
  parentId  String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    HrDepartment?  @relation("HrDepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  HrDepartment[] @relation("HrDepartmentTree")
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentId])
}

model HrDesignation {
  id        String     @id @default(cuid())
  companyId String
  name      String
  code      String?
  level     Int?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
}

model HrBranch {
  id        String     @id @default(cuid())
  companyId String
  name      String
  code      String?
  address   String?
  city      String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
}

model EmployeeDocument {
  id           String    @id @default(cuid())
  employeeId   String
  title        String
  category     String    @default("GENERAL")
  fileUrl      String
  mimeType     String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy   Employee? @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([uploadedById])
}

model EmployeeSkill {
  id          String    @id @default(cuid())
  employeeId  String
  name        String
  level       String?
  certifiedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeDependent {
  id          String    @id @default(cuid())
  employeeId  String
  name        String
  relation    String
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeActivity {
  id         String    @id @default(cuid())
  employeeId String
  actorId    String?
  type       String
  message    String
  meta       Json?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation("EmployeeActivities", fields: [employeeId], references: [id], onDelete: Cascade)
  actor      Employee? @relation("EmployeeActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

