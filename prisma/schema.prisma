  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  cycle        PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee         @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  manager      Employee?        @relation("ReviewManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@unique([cycleId, employeeId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([managerId])
}

model HrTicket {
  id          String    @id @default(cuid())
  companyId   String
  employeeId  String
  assigneeId  String?
  category    String    @default("GENERAL")
  subject     String
  body        String    @db.Text
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee  @relation("HrTicketRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  assignee    Employee? @relation("HrTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([assigneeId])
  @@index([status])
}

model HrPolicyDoc {
  id        String   @id @default(cuid())
  companyId String
  title     String
  fileUrl   String
  category  String   @default("HANDBOOK")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String
  status      String
  /// website | webapp | seo | branding | retainer | other
  projectType String    @default("other")
  progress    Int       @default(0)
  startDate   DateTime
  endDate     DateTime
  companyId   String
  customerId  String?
  dealId      String?
  pmUserId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  pmUser      User?     @relation("ProjectPm", fields: [pmUserId], references: [id], onDelete: SetNull)
  budgets     Budget[]
  milestones  ProjectMilestone[]
  members     ProjectMember[]
  tasks       ProjectTask[]
  tickets     SupportTicket[]
  timesheetEntries TimesheetEntry[]
  retainers   ClientRetainer[]

  @@index([companyId])
  @@index([customerId])
  @@index([dealId])
  @@index([pmUserId])
  @@index([status])
  @@index([startDate, endDate])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  /// PENDING | IN_PROGRESS | DONE
  status      String    @default("PENDING")
  dueDate     DateTime?
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

/// Delivery work items — Kanban/list board (ClickUp / Jira style)
model ProjectTask {
  id              String    @id @default(cuid())
  projectId       String
  /// Parent task for Jira-style subtasks (null = top-level)
  parentTaskId    String?
  title           String
  description     String?
  /// Rich HTML description (TipTap); plain `description` kept for list previews
  descriptionHtml String?   @db.Text
  /// BACKLOG | TODO | IN_PROGRESS | IN_REVIEW | DONE (or company-custom)
  status          String    @default("TODO")
  /// LOW | MEDIUM | HIGH | URGENT
  priority        String    @default("MEDIUM")
  assigneeId      String?
  reporterId      String?
  dueDate         DateTime?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask      ProjectTask?  @relation("ProjectTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks        ProjectTask[] @relation("ProjectTaskSubtasks")
  assignee        User?     @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter        User?     @relation("ProjectTaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  comments        ProjectTaskComment[]
  watchers        ProjectTaskWatcher[]
  activities      ProjectTaskActivity[]
  attachments     ProjectTaskAttachment[]

  @@index([projectId])
  @@index([parentTaskId])
  @@index([status])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([dueDate])
  @@index([projectId, status, sortOrder])
  @@index([projectId, parentTaskId])
}

model ProjectTaskComment {
  id          String   @id @default(cuid())
  taskId      String
  authorId    String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User     @relation("ProjectTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments ProjectTaskAttachment[]

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
}

model ProjectTaskWatcher {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("ProjectTaskWatchers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model ProjectTaskActivity {
  id          String   @id @default(cuid())
  taskId      String
  actorId     String?
  eventType   String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor       User?    @relation("ProjectTaskActivities", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([createdAt])
  @@index([eventType])
}

model ProjectTaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  fileId       String?
  url          String
  name         String?
  mimeType     String?
  size         Int?
  uploadedById String?
  /// DESCRIPTION | COMMENT | SIDEBAR
  source       String   @default("SIDEBAR")
  commentId    String?
  createdAt    DateTime @default(now())
  task         ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment      ProjectTaskComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploadedBy   User?    @relation("ProjectTaskAttachments", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([commentId])
  @@index([uploadedById])
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  /// PM | DESIGN | DEV | SEO | OTHER
  role       String   @default("OTHER")
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation("ProjectMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

/// Recurring client retainers (SEO, hosting, care plans) — distinct from SaaS Subscription
model ClientRetainer {
  id            String    @id @default(cuid())
  companyId     String
  customerId    String
  projectId     String?
  name          String
  description   String?
  amount        Float
  currency      String    @default("USD")
  /// MONTHLY | QUARTERLY | YEARLY
  billingCycle  String    @default("MONTHLY")
  /// ACTIVE | PAUSED | CANCELLED | ENDED
  status        String    @default("ACTIVE")
  startDate     DateTime  @default(now())
  nextBillAt    DateTime?
  lastBilledAt  DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([nextBillAt])
}

// ── B2B: Client Management (legacy — product uses Customer; keep for data compat) ─

model Client {
  id             String   @id @default(cuid())
  name           String
  contact        String
  email          String   @unique
  phone          String
  address        Json
  companyId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id])
  convertedLeads Lead[]   @relation("ClientConvertedLead")

  @@index([companyId])
  @@index([email])
}

model LeadDocument {
  id         String   @id @default(cuid())
  leadId     String
  name       String
  type       String
  url        String
  employeeId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy Employee @relation(fields: [employeeId], references: [id])

  @@index([leadId])
  @@index([employeeId])
}

// ── Internal Task Management (Employee-Based with Sub-Tasks) ─────────────

model CompanyTask {
  id          String              @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      CompanyTaskStatus   @default(TODO)
  priority    CompanyTaskPriority @default(LOW)
  category    CompanyTaskCategory @default(GENERAL)
  progress    Int                 @default(0)

  parentTaskId String?
  parentTask   CompanyTask?  @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     CompanyTask[] @relation("SubTasks")

  createdById  String
  assignedToId String
  companyId    String

  startedAt   DateTime?
  completedAt DateTime?
  attachments Json?
  tags        String[]
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments CompanyTaskComment[]
  creator  Employee             @relation("TaskCreator", fields: [createdById], references: [id])
  assignee Employee             @relation("TaskAssignee", fields: [assignedToId], references: [id])
  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([assignedToId])
  @@index([createdById])
  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([parentTaskId])
}

model CompanyTaskComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  taskId    String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   CompanyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Employee    @relation(fields: [createdBy], references: [id])

  @@index([taskId])
  @@index([createdBy])
}

// ── Inventory & Procurement ───────────────────────────────────────────────

model Location {
  id               String            @id @default(cuid())
  name             String
  type             String
  address          String
  code             String            @unique
  companyId        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id])
  batchItems       BatchItem[]
  inventoryRecords InventoryRecord[]
  products         Product[]         @relation("ProductLocations")
  transfersFrom    StockTransfer[]   @relation("TransferSource")
  transfersTo      StockTransfer[]   @relation("TransferTarget")
  demoUnitsHere    DemoEquipmentUnit[] @relation("DemoUnitLocation")
  demoMovesFrom    DemoEquipmentMovement[] @relation("DemoMoveFromLocation")
  demoMovesTo      DemoEquipmentMovement[] @relation("DemoMoveToLocation")

  @@index([companyId])
}

model BatchItem {
  id           String    @id @default(cuid())
  batchNumber  String
  serialNumber String?
  quantity     Int
  expiryDate   DateTime?
  productId    String
  locationId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  location     Location  @relation(fields: [locationId], references: [id])
  product      Product   @relation(fields: [productId], references: [id])

  @@unique([batchNumber, productId])
  @@index([locationId])
  @@index([productId])
}

model InventoryRecord {
  id             String    @id @default(cuid())
  productId      String
  quantity       Int
  price          Float
  companyId      String
  type           String
  notes          String?
  reason         String
  batchNumber    String?
  locationId     String?
  serialNumber   String?
  sourceLocation String?
  targetLocation String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id])
  location       Location? @relation(fields: [locationId], references: [id])
  product        Product   @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([locationId])
  @@index([productId])
  @@index([type])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  email     String          @unique
  phone     String
  address   String
  companyId String
  rating    Float?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  products  Product[]
  orders    PurchaseOrder[]
  company   Company         @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  poNumber    String    @unique
  supplierId  String
  status      POStatus  @default(DRAFT)
  totalAmount Float
  companyId   String
  /// [{ productId, name?, quantity, unitPrice }]
  lineItems   Json?
  notes       String?
  approvedAt  DateTime?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id])
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  products    Product[] @relation("POProducts")

  @@index([companyId])
  @@index([supplierId])
}

model SalesOrder {
  id          String    @id @default(cuid())
  orderNumber String    @unique
  status      SOStatus  @default(PENDING)
  totalAmount Float
  companyId   String
  /// [{ productId, name?, quantity, unitPrice }]
  lineItems   Json?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id])
  products    Product[] @relation("SOProducts")

  @@index([companyId])
}

model StockTransfer {
  id               String   @id @default(cuid())
  productId        String
  sourceLocationId String
  targetLocationId String
  quantity         Int
  batchNumber      String?
  companyId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product        Product  @relation(fields: [productId], references: [id])
  sourceLocation Location @relation("TransferSource", fields: [sourceLocationId], references: [id])
  targetLocation Location @relation("TransferTarget", fields: [targetLocationId], references: [id])
  company        Company  @relation(fields: [companyId], references: [id])

  @@index([productId])
  @@index([sourceLocationId])
  @@index([targetLocationId])
  @@index([companyId])
}

// ── Multi-Tenancy: User ↔ Company ─────────────────────────────────────────

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastActive DateTime @default(now())
  isValid    Boolean  @default(true)
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model UserCompany {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model UserCompanyRole {
  id           String      @id @default(cuid())
  userId       String
  companyId    String
  role         CompanyRole @default(USER)
  assignedById String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  employee     Employee    @relation(fields: [assignedById], references: [id], onDelete: Cascade)
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([role])
  @@index([userId])
}

model UserSettings {
  id            String @id @default(cuid())
  userId        String @unique
  notifications Json
  theme         String
  language      String
  user          User   @relation(fields: [userId], references: [id])
}

