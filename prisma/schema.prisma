// ── Communication: Employee Messaging ─────────────────────────────────────

model EmployeeMessage {
  id         String                @id @default(cuid())
  content    String                @db.Text
  senderId   String
  receiverId String
  status     EmployeeMessageStatus @default(SENT)
  type       EmployeeMessageType   @default(TEXT)
  readAt     DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  sender   Employee @relation("SentMessages", fields: [senderId], references: [id])
  receiver Employee @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

