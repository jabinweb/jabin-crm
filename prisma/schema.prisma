  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actionBy    Employee? @relation("TravelApprover", fields: [actionById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([actionById])
}

model Timesheet {
