  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
  INDEPENDENT_CONTRACTOR
  VOLUNTEER
  SELF_EMPLOYED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
  EMPLOYEE
}

enum UserStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  SUSPENDED
  DELETED
}

enum EmployeeMessageStatus {
