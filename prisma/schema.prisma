  updatedAt                DateTime               @updatedAt
  company                  Company                @relation(fields: [companyId], references: [id])
  equipmentInstallation    EquipmentInstallation? @relation(fields: [equipmentInstallationId], references: [id], onDelete: SetNull)
  assignedToEmployee       Employee?              @relation("EmployeeAssets", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([type])
  @@index([equipmentInstallationId])
  @@index([assignedToEmployeeId])
}

model Budget {
