  policy     LeavePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([actionById])
  @@index([policyId])
}

model LeavePolicy {
  id               String         @id @default(cuid())
  companyId        String
  name             String
  code             String
