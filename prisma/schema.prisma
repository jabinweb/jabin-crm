  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CompanyTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CompanyTaskCategory {
  GENERAL
  PROJECT
  MAINTENANCE
  DEVELOPMENT
